{
	"name": "TikTok Download Buttons",
	"description": "Adds download buttons to TikTok videos",
	"author": "emy",
	"manifest_version": 3,
	"version": "1.2.1",
	"homepage_url": "https://github.com/sixem/tiktok-download-buttons",
	"icons": {
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"48": "icons/48.png",
			"128": "icons/128.png"
		}
	},
	"background": {
		"service_worker": "service.js"
	},
	"content_scripts": [{
		"matches": [
			"https://tiktok.com/*",
			"https://www.tiktok.com/*"
		],
		"js": ["main.js"],
		"css": ["main.css"],
		"run_at": "document_idle"
	}],
	"permissions": [
		"downloads",
		"storage"
	],
	"host_permissions": [
		"*://*.tiktok.com/*",
		"https://tiktok.com/*",
		"https://*.tiktokcdn.com/*",
		"https://*.tiktokv.com/*"
	]
}
