{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"strict": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"allowJs": false,
		"checkJs": false,
		"noEmit": true,
		"useDefineForClassFields": true
	},
	"include": ["src"]
}
