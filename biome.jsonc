{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	// Keep the first Biome setup narrow: lint source files, but do not take over formatting yet.
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**/*.ts",
			"scripts/**/*.js",
			"vite.config.js"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	}
}
